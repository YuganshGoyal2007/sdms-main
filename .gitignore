# =====================================================
# GBU-SDMS .gitignore
# =====================================================
# This file lives at the repo root. Sub-folders (backend/, frontend/)
# have their own .gitignore for language-specific stuff.

# ─── Secrets / env ──────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example
!.env.sample
!.env.dist

# ─── Database dumps, seeds & runtime storage ────────
*.sql
*.sql.gz
*.sql.bak
*.dump
*.xlsx
*.xls
~$*.xlsx
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dump.rdb
db_dumps/
mysql_data/
database/
data/exports/
data/dumps/
backups/
backend/backups/
scripts/seed-*.js
scripts/seed-*.mjs
!backend/scripts/migrate-*.js    # migrations are code, not data

# ─── Database files at the repo root (NO DB EXPOSURE!) ─
db-*.sql
gbu_sdms_*.sql
sdms_*.sql
database_*.sql
**/dump-*.sql
**/backup-*.sql
backend/database.sqlite
**/database.sqlite*

# ─── Test outputs, evidence & coverage ──────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
e2e_evidence/
screenshots/
backend/screenshots/
*.test.log
test.log
junit.xml
.jest/
*REPORT.json
*report.json
*.test.json
tmp_*.mjs
tmp_*.js

# ─── User Uploads & Media Storage ───────────────────
uploads/
backend/uploads/
storage/
media_storage/
tmp/
temp/
scratch/
*.tmp

# ─── Backup / runtime artifacts ──────────────────────
*.log
logs/
backend/logs/
*.pid
*.seed
*.pid.lock
database backup zip/
*.zip

# ─── Local dev / IDE noise ───────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.bak
*.orig

# ─── Node / build artifacts (also in sub-gitignores) ─
node_modules/
dist/
build/
.next/
*.tsbuildinfo
coverage/
.nyc_output/

# ─── OS-specific ─────────────────────────────────────
.DS_Store
desktop.ini
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
$RECYCLE.BIN/
*.lnk

# ─── Frontend (Vite/React) extras ───────────────────
.vite/
.cache/
.parcel-cache/

# ─── Editor scratch ─────────────────────────────────
.vscode-test/
.idea_modules/
*.iml

# Archives
*.zip
*.tar
*.tar.gz

