# =========================================================================
# GBU-SDMS Frontend Environment Variables
# =========================================================================
# Copy this file to `.env` and fill in your local values.
# `.env` is git-ignored — never commit it with real secrets.
# -------------------------------------------------------------------------

# --- Runtime mode ---
VITE_ENV_MODE=development

# --- Backend API base URL ---
# Local dev:           http://localhost:5000
# Staging:             https://sdms-staging.gbu.ac.in
# Production:          https://sdms.gbu.ac.in
VITE_BACKEND_URL=http://localhost:5000

# --- Frontend public URL (used for CORS, share links) ---
VITE_FRONTEND_URL=http://localhost:5173/
