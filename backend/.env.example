DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# DB_PASSWORD=your_db_password (set a secure password)
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=gbu_sdms

JWT_SECRET=replace_with_jwt_secret
JWT_ACCESS_SECRET=replace_with_jwt_access_secret
ACCESS_TOKEN_EXP=1h

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER="no-reply@example.com"
# Backend environment variables
# Use MySQL by setting DB_DIALECT to mysql and configuring the values below.
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gbu_sdms

# If you want to use SQLite fallback instead, set DB_DIALECT=sqlite
# and optionally configure the storage file path.
# DB_DIALECT=sqlite
# SQLITE_STORAGE=database.sqlite

JWT_SECRET=your_jwt_secret
JWT_ACCESS_SECRET=your_jwt_secret
ACCESS_TOKEN_EXP=1h
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER="no-reply@example.com"