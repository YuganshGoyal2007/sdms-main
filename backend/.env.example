# =========================================================================
# GBU-SDMS Backend Environment Variables
# =========================================================================
# Copy this file to `.env` and fill in your local values.
# `.env` is git-ignored — never commit it with real secrets.
# -------------------------------------------------------------------------

# --- Database ---
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_dev_only
DB_NAME=gbu_sdms

# --- Auth (CHANGE BEFORE DEPLOY) ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_dev_only_replace_in_prod
JWT_ACCESS_SECRET=CHANGE_ME_dev_only_replace_in_prod
ACCESS_TOKEN_EXP=1h

# --- Dev-only OTP backdoor (REMOVE in production) ---
COMMON_OTP=270720

# --- SMTP (only needed if you implement real email OTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER="no-reply@gbu.ac.in"

# --- Backups (Windows scheduled task) ---
BACKUP_DIR=C:\backups\gbu-sdms
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe

# --- Auto-sync mygbu.in timetables (cron expression) ---
# 0 */6 * * *  = every 6 hours
TIMETABLE_CRON=0 */6 * * *
